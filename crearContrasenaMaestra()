// BALAM - punt d'entrada
// Creació i verificació de la contrasenya mestra connectades.
#include <iostream>
#include <stdexcept>
#include <string>

#include "auth.h"

// Funcion para crear la contrasena maestra
// Canvis: entrada oculta + es guarda el hash a master.dat amb auth::guardarMestra
bool crearContrasenaMaestra(std::string& contrasenaMaestra)
{
    std::cout << "=== BALAM ===\n";
    std::cout << "Crear contrasena maestra\n\n";

    std::string contrasena = auth::llegirOcult("Introduce una contrasena (minimo 8 caracteres): ");

    // Comprobar la longitud
    if (contrasena.length() < auth::LONGITUD_MINIMA)
    {
        std::cout << "Error: la contrasena es demasiado corta.\n";
        return false;
    }

    // Confirmar la contrasena
    std::string confirmar = auth::llegirOcult("Repite la contrasena: ");
    if (contrasena != confirmar)
    {
        std::cout << "Error: las contrasenas no coinciden.\n";
        return false;
    }

    try
    {
        auth::guardarMestra(contrasena);   // NOU: sense això, al tancar el programa es perd
    }
    catch (const std::exception& e)
    {
        std::cout << "Error: " << e.what() << "\n";
        return false;
    }

    contrasenaMaestra = contrasena;
    std::cout << "\nContrasena maestra creada correctamente.\n";
    return true;
}

int main()
{
    std::string contrasenaMaestra;

    if (!auth::existeixMestra())
    {
        // Primera vegada: crear
        while (!crearContrasenaMaestra(contrasenaMaestra)) {}
        std::cout << "\nConfiguracion inicial completada.\n";
    }
    else
    {
        // Les següents vegades: verificar
        if (!auth::demanarMestra(contrasenaMaestra))
            return 1;
    }

    // Aquí anirà el menú principal
    std::cout << "\n[Menu principal]\n";
    return 0;
}
